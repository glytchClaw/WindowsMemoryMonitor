<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 com rescap">

  <!-- Publisher must match the subject of the signing certificate that Build.ps1 creates. -->
  <Identity
    Name="MemoryMonitorWidget"
    Publisher="CN=MemoryMonitorWidget"
    Version="1.1.0.0" />

  <Properties>
    <DisplayName>Memory Monitor Widget</DisplayName>
    <PublisherDisplayName>Local build</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="MemoryWidget.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Memory Monitor Widget"
        Description="Shows RAM in use and checks that the GPU/NPU shared memory limit stays under 5 GB."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="MemoryWidget.exe" Arguments="-RegisterProcessAsComServer" DisplayName="Memory Monitor Widget Provider">
              <com:Class Id="8E3B6F5A-2C41-4D7E-9B6A-5F1C3A7D9E21" DisplayName="MemoryWidgetProvider" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <uap3:Extension Category="windows.appExtension">
          <uap3:AppExtension Name="com.microsoft.windows.widgets" DisplayName="Memory Monitor" Id="MemoryMonitor" PublicFolder="Public">
            <uap3:Properties>
              <WidgetProvider>
                <ProviderIcons>
                  <Icon Path="Assets\WidgetIcon.png" />
                </ProviderIcons>
                <Activation>
                  <CreateInstance ClassId="8E3B6F5A-2C41-4D7E-9B6A-5F1C3A7D9E21" />
                </Activation>
                <Definitions>
                  <Definition
                    Id="MemoryMonitor_Widget"
                    DisplayName="Memory Monitor"
                    Description="RAM in use, plus a check that the GPU/NPU shared memory limit stays under your target (5 GB by default)."
                    IsCustomizable="true">
                    <Capabilities>
                      <Capability><Size Name="small" /></Capability>
                      <Capability><Size Name="medium" /></Capability>
                      <Capability><Size Name="large" /></Capability>
                    </Capabilities>
                    <ThemeResources>
                      <Icons>
                        <Icon Path="Assets\WidgetIcon.png" />
                      </Icons>
                      <Screenshots>
                        <Screenshot Path="Assets\WidgetScreenshot.png" DisplayAltText="Memory Monitor widget showing RAM in use and the GPU/NPU limit" />
                      </Screenshots>
                      <DarkMode />
                      <LightMode />
                    </ThemeResources>
                  </Definition>
                </Definitions>
              </WidgetProvider>
            </uap3:Properties>
          </uap3:AppExtension>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
